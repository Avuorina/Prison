#> main:book/prisoner
#
# 囚人手帳(ルールブック)をgive
#
# @s 本を受け取る人(囚人)

    give @s written_book[written_book_content={"title": "囚人手帳", "author": "刑務所長", "pages": [{"text": "", "extra": [{"text": "囚人手帳\n\n", "bold": true}, {"text": "この手帳を常に携帯し\n規則を守ること。\n\n一、日課\n二、作業日と免業日\n三、処刑までの日数\n四、禁止事項\n五、懲罰\n六、持ち物\n\n"}, {"text": "――刑務所長", "color": "dark_gray"}]}, {"text": "", "extra": [{"text": "一、日課\n\n", "bold": true}, {"text": "06:00 起床・点呼\n07:00 朝食\n08:00 作業/自由時間\n12:00 昼食\n13:00 作業/入浴・自由\n17:00 夕食・所持品検査\n18:00 房内で自由時間\n21:00 消灯\n\n"}, {"text": "1日は実時間で30分。", "color": "dark_gray"}]}, {"text": "", "extra": [{"text": "二、作業日と免業日\n\n", "bold": true}, {"text": "奇数日は作業日。\n厨房・畑・牧場で\n刑務作業を行う。\n\n偶数日は免業日。\n作業はなく\n自由時間となる。\n\n作業の担当は\n看守が決める。"}]}, {"text": "", "extra": [{"text": "三、処刑までの日数\n\n", "bold": true}, {"text": "処刑まで30日。\n\n日数が0になった\n翌朝から処刑の対象。\n看守に捕まれば\n処刑場へ送られる。\n\n規則を破れば\n日数は減る。\n模範的にすごせば\n増えることもある。"}]}, {"text": "", "extra": [{"text": "四、禁止事項\n\n", "bold": true}, {"text": "・脱獄\n・禁制品の所持\n　道具、刃物\n　火気、爆発物\n　鍵\n　木材、鉄などの資材\n・看守への反抗\n・許可のない\n　持ち場の離脱\n\n"}, {"text": "刑務所内には\n所持品検査の\nゲートがある。", "color": "dark_gray"}]}, {"text": "", "extra": [{"text": "五、懲罰\n\n", "bold": true}, {"text": "違反した者は\n手錠をかけ\n懲罰房へ送る。\n\n懲罰房の前で\n持ち物をすべて\n差し出すこと。\n\n看守が扉を開けるまで\n懲罰房から出ては\nならない。"}]}, {"text": "", "extra": [{"text": "六、持ち物\n\n", "bold": true}, {"text": "支給品は\n囚人服とランタン。\n\n囚人服は\n脱ぐことができない。\n\n死亡した場合は\n自分の房で\n目を覚ます。\n\n――以上"}]}]},lore=[{"text": "所内規則", "color": "gray", "italic": false}]] 1
