#> main:book/guard
#
# 看守の手引き(ルールブック)をgive
#
# @s 本を受け取る人(看守)

    give @s written_book[written_book_content={"title": "看守の手引き", "author": "刑務所長", "pages": [{"text": "", "extra": [{"text": "看守の手引き\n\n", "bold": true}, {"text": "一、支給品\n二、監視カメラ\n三、処刑までの日数\n四、所持品検査ゲート\n五、鍵と扉\n六、懲罰房\n七、脱獄の通知\n\n"}, {"text": "――刑務所長", "color": "dark_gray"}]}, {"text": "", "extra": [{"text": "一、支給品\n\n", "bold": true}, {"text": "警棒\n　2発で囚人を倒す\n手錠\n　殴った囚人を\n　懲罰房へ送る\nマスターキー\n　どの扉も開く\n日課の速さ\n　右クリックで\n　等速→×2→×5→×10\n　→1/2→1/10→一時停止"}]}, {"text": "", "extra": [{"text": "二、監視カメラ\n\n", "bold": true}, {"text": "モニターをクリックで\nカメラの視点になる。\n\n右クリック:次のカメラ\nスニーク:戻る\n\n見ている間、看守は\n透明になり、その場に\nダミーが残る。\n持ち物は預かり、\n戻ると返る。"}]}, {"text": "", "extra": [{"text": "三、処刑までの日数\n\n", "bold": true}, {"text": "房の扉の上の表示を\nクリックすると\nボタンが出る。\n[懲罰 −1日][恩赦 +1日]\n\n0日の翌朝から\n処刑の対象になる。\n手錠で捕まえると\n処刑場へ送られ、\n3秒後に看守も向かう。\nレバーで刑を執行せよ。"}]}, {"text": "", "extra": [{"text": "四、所持品検査ゲート\n\n", "bold": true}, {"text": "床のブロックで種類が\n変わる。\n\nレッドストーンブロック\n　金属\nコマンドブロック\n　すべての持ち物\n　(ランタンは除く)\nアメジストブロック\n　禁制品\n\n"}, {"text": "看守は反応しない。", "color": "dark_gray"}]}, {"text": "", "extra": [{"text": "四、ゲート(続き)\n\n", "bold": true}, {"text": "引っかかった囚人は\n3秒光り、\n周りのランプが点き、\nブザーが鳴る。\n\n禁制品\n　道具、火気、爆発物\n　鍵、木材や鉄などの\n　資材"}]}, {"text": "", "extra": [{"text": "五、鍵と扉\n\n", "bold": true}, {"text": "色の鍵は\n同じ色のコンクリートの\n鍵穴の扉を開ける。\n\nオレンジと\n深層岩タイルの扉は\nマスターキー専用。\n\n紫の鍵は作業日に\n調理担当へ渡す。"}]}, {"text": "", "extra": [{"text": "六、懲罰房\n\n", "bold": true}, {"text": "手錠で殴ると\n2つの懲罰房の\nどちらかへ送られ、\nチャットで場所を\n知らせる。\n\n前のゲートで\n持ち物を出させ、\nシュルカーボックスに\n押収すること。\n\n出すときは\n扉を開けてやる。"}]}, {"text": "", "extra": [{"text": "七、脱獄の通知\n\n", "bold": true}, {"text": "水門が開いたとき、\n囚人が塀の外に\n出たときに通知が来る。\n\n塀の外で10秒\n耐えられたら\n脱獄成功。\n\nその前に捕まえろ。"}]}]},lore=[{"text": "看守専用", "color": "gray", "italic": false}]] 1
